{
  "font": "DejaVu Sans Mono 10",
  "ptyxis_palette": "xterm",
  "foreground": "#ffffff",
  "background": "#000000",
  "palette": ["#000000", "#cd0000", "#00cd00", "#cdcd00", "#0000ee", "#cd00cd", "#00cdcd", "#e5e5e5", "#7f7f7f", "#ff0000", "#00ff00", "#ffff00", "#5c5cff", "#ff00ff", "#00ffff", "#ffffff"],
  "tiling": {
    "dynamic-keybinding-behavior": "1",
    "focus-hint": "3",
    "focus-hint-color": "'rgb(4,217,255)'",
    "focus-hint-outline-border-radius": "6",
    "focus-hint-outline-size": "4",
    "focus-hint-outline-style": "1",
    "single-screen-gap": "8",
    "window-gap": "8",
    "tiling-popup-all-workspace": "true"
  }
}

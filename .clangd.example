# .clangd — place this at your project root
# Works for: ROS2 · ESP32 (ESP-IDF) · STM32 (PlatformIO) · Arduino

CompileFlags:
  # Use the compile_commands.json generated by your build system:
  #
  #   ROS2 / colcon:
  #     colcon build --cmake-args -DCMAKE_EXPORT_COMPILE_COMMANDS=ON
  #     ln -s build/compile_commands.json compile_commands.json
  #
  #   ESP32 / ESP-IDF:
  #     idf.py build                 (auto-generates in build/)
  #     ln -s build/compile_commands.json compile_commands.json
  #
  #   ESP32 / PlatformIO:
  #     pio run                      (generates in .pio/build/<env>/)
  #     ln -s .pio/build/<env>/compile_commands.json compile_commands.json
  #
  #   STM32 / PlatformIO:            same as ESP32 above
  #   STM32 / STM32CubeIDE + cmake:  set CMAKE_EXPORT_COMPILE_COMMANDS=ON
  #
  #   Arduino (easiest path):
  #     Use PlatformIO for Arduino projects – it generates compile_commands.json
  #     If you must use arduino-cli, install `arduino-language-server` via Mason
  #     and point it to your sketch directory.

  Add:
    # Silence common warnings from vendor headers
    - -Wno-unknown-pragmas
    - -Wno-unused-variable

  Remove:
    # Remove flags clangd doesn't understand (common with ROS2)
    - -mno-global-merge

Diagnostics:
  # Suppress noisy checks in generated / vendor code
  Suppress:
    - "-warnings-as-errors"

---
# ── ROS2 specific ───────────────────────────────────────────────
# If Clangd can't find ROS headers, add:
# CompileFlags:
#   Add:
#     - -I/opt/ros/humble/include
#     - -I/opt/ros/humble/include/rclcpp
#     - -I/opt/ros/humble/include/std_msgs
